# ==============================================================================
# OKADA BOOK — CLIENT-SIDE ENVIRONMENT VARIABLES
# ==============================================================================
# Client/Browser safe credentials (Publishable anon key only)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or database connection strings here!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ==============================================================================
# FIREBASE CLOUD MESSAGING (FCM) — CLIENT-SIDE CREDENTIALS
# Web app credentials from Firebase Console -> Project Settings -> General
# ==============================================================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-numbers
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-certificates-vapid-key

# ==============================================================================
# SERVER-SIDE SECRETS (Configure in Supabase Dashboard / Edge Function Secrets)
# Do NOT prefix with VITE_ to keep them private from the client bundle.
# ==============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

